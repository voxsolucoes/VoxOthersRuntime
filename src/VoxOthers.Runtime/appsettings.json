{
  // ==========================================================================
  // Vox Others Runtime 2.0 — exemplo mínimo de configuração (perfil padrão).
  //
  // Este arquivo é o que o serviço lê quando nenhum ambiente é informado
  // (ASPNETCORE_ENVIRONMENT). Ele SOBE como está: a validação passa, o
  // processo inicia e /health/live responde verde.
  //
  // Antes do go-live, ajuste três coisas:
  //   1. Caminhos — aqui apontam para a árvore exemplo\ dentro do projeto.
  //      O Runtime cria sozinho working\, processed\ e quarantine\; a pasta
  //      de entrada (inbox) é combinada com o Builder e não é criada por aqui.
  //   2. Conexão com o banco — preencha os campos em "VoxDatabase" abaixo
  //      (servidor, porta, base, usuário, senha): o Runtime monta a
  //      connection string sozinho, ninguém precisa saber montar. Se preferir
  //      a string inteira, use a variável de ambiente
  //      ConnectionStrings__VoxDatabase, que tem precedência (nunca
  //      credencial real versionada no arquivo).
  //   3. Chaves de API do webhook — troque a origem e a chave de exemplo por
  //      uma chave forte por origem autorizada (Builder, Marketplace, ...).
  //
  // O provedor de configuração do .NET aceita comentários e vírgula final.
  // ==========================================================================
  "VoxDatabase": {
    // Campos da base do Vox (Firebird), preenchidos um a um — igual às
    // chaves do App.voxconfig antigo. Exemplo aponta para localhost; antes
    // do go-live troque para o servidor real.
    "Server": "localhost",
    "Port": 3050,
    "Database": "vox",
    "User": "SYSDBA",
    "Password": "",
    "Charset": "NONE",
    "Dialect": 3,
    // Pool de conexoes — mesmos parametros do FrameworkCIT (clsDatabase):
    // mantem um minimo aberto, limita o maximo e revalida a cada 5 min.
    "Pooling": true,
    "MinPoolSize": 5,
    "MaxPoolSize": 50,
    "ConnectionLifetimeSeconds": 300,
    "ConnectionTimeoutSeconds": 30,
    "Enlist": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    // File log: one file per day in C:\\Simulacao\\Logs\\VoxOthersRuntime,
    // in the same format as the console lines. Needed for log-based validation
    // when the process runs as a Windows service.
    "File": {
      "Path": "C:\\Simulacao\\Logs\\VoxOthersRuntime",
      "FileName": "VoxOthersRuntime",
      "Extension": "log",
      "IncludeScopes": true,
      "SingleLine": true,
      "UseUtcTimestamp": false,
      "TimestampFormat": "[yyyy-MM-dd HH:mm:ss.fff] "
    }
  },
  "AllowedHosts": "*",
  "Runtime": {
    "WorkerCount": 4,
    "ChannelCapacity": 1000,
    "WorkingHours": {
      "Enabled": false,
      "Start": "08:00",
      "End": "20:00"
    },
    "Retry": {
      "MaxAttempts": 3,
      "BaseDelaySeconds": 5
    },
    "OperationDefaults": {
      "DiscardZeroDuration": true,
      "MediaWaitSeconds": 60
    }
  },
  "Grf": {
    "RegisterPath": "C:\\Simulacao\\Grav\\REGBD",
    "WorkPath": "C:\\Simulacao\\BuilderOthers",
    "RecordingRoot": "C:\\Simulacao\\Grav",
    "ServerName": "VOXPERFECT01"
  },
  "Quarantine": {
    "Path": "C:\\Simulacao\\Quarentine",
    "ReprocessedRetentionDays": 30
  },
  "Deduplication": {
    "Path": "C:\\Simulacao\\ImportHistory",
    "RetentionDays": 90
  },
  "Ingestion": {
    "Folder": {
      "Enabled": true,
      "Paths": [ "C:\\Simulacao\\BuilderOthers" ],
      "WorkingPath": "C:\\Simulacao\\Working",
      "QuarantinePath": "C:\\Simulacao\\Quarentine",
      "ProcessedPath": "C:\\Simulacao\\Processed",
      "FilePattern": "*.json",
      "ScanIntervalSeconds": 30
    },
    "Webhook": {
      "Enabled": true,
      "Path": "/api/v1/centralize",
      "MaxBatchSize": 500,
      "RequireApiKey": true,
      "ApiKeys": {
        "builder-exemplo": "troque-esta-chave"
      }
    }
  }
}
